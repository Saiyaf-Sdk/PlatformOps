# ==============================================================================
# PlatformOps — Frontend Environment Template (Frontend/.env.example)
# ==============================================================================
# Copy this file to 'Frontend/.env' for local frontend development.
# ==============================================================================

# Backend API base URL
VITE_API_URL=http://localhost:8081/api/v1

# UI Feature Flags: set to true to hide demo credential autofill on login page
VITE_HIDE_DEMO=false
