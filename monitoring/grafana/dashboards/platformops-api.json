{
  "uid": "platformops-api",
  "title": "PlatformOps API",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries", "title": "Requests / second", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"platformops-api\", uri!~\"/actuator.*\"}[1m]))", "legendFormat": "{{uri}}" }]
    },
    {
      "type": "timeseries", "title": "p95 latency (s)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"platformops-api\"}[5m])))", "legendFormat": "p95" }]
    },
    {
      "type": "stat", "title": "5xx in last 5m", "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(http_server_requests_seconds_count{application=\"platformops-api\", status=~\"5..\"}[5m])) or vector(0)" }]
    },
    {
      "type": "stat", "title": "JVM heap used", "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{application=\"platformops-api\", area=\"heap\"})" }]
    },
    {
      "type": "stat", "title": "DB connections active", "gridPos": { "x": 12, "y": 8, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(hikaricp_connections_active{application=\"platformops-api\"})" }]
    },
    {
      "type": "stat", "title": "Uptime", "gridPos": { "x": 18, "y": 8, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "max(process_uptime_seconds{application=\"platformops-api\"})" }]
    }
  ]
}
