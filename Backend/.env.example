# ==============================================================================
# PlatformOps — Backend Environment Template (Backend/.env.example)
# ==============================================================================
# Copy this file to 'Backend/.env' for local backend development.
# ==============================================================================

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=platformops
DB_USERNAME=platformops
DB_PASSWORD=change_me
DB_URL=jdbc:postgresql://localhost:5432/platformops
DB_POOL_SIZE=10

# Server Port
PORT=8081
FORWARD_HEADERS_STRATEGY=none

# Security & Authentication
# JWT Secret (Base64-encoded, at least 256 bits). ALWAYS override in production.
# Generate with: openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktcGxhdGZvcm1vcHMtc2VjcmV0LWNoYW5nZS1tZS1pbi1wcm9kdWN0aW9uLTEyMzQ1Njc4OTA=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Platform Simulator & Demo Seed
SEED_DEMO_DATA=true
PIPELINE_STAGE_DELAY=PT2.5S
PIPELINE_FAILURE_RATE=0.05
