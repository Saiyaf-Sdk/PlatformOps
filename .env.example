# ==============================================================================
# PlatformOps — Root Environment Template (.env.example)
# ==============================================================================
# Copy this file to '.env' in the project root or respective subdirectories.
# NEVER commit real credentials, production secrets, or private keys to Git.
#
# Defaults here match standard local development:
# - PostgreSQL running on localhost:5432
# - Spring Boot API running on localhost:8081
# - React Vite Frontend running on localhost:5173
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=platformops
DB_USERNAME=platformops
DB_PASSWORD=change_me
DB_URL=jdbc:postgresql://localhost:5432/platformops
DB_POOL_SIZE=10

# ------------------------------------------------------------------------------
# Backend API Configuration (Spring Boot)
# ------------------------------------------------------------------------------
PORT=8081
FORWARD_HEADERS_STRATEGY=none

# Security & Authentication (HMAC-SHA Key - Base64 encoded, min 256-bit / 32 bytes)
# For production, generate with: openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktcGxhdGZvcm1vcHMtc2VjcmV0LWNoYW5nZS1tZS1pbi1wcm9kdWN0aW9uLTEyMzQ1Njc4OTA=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Platform Simulation & Seeding
SEED_DEMO_DATA=true
PIPELINE_STAGE_DELAY=PT2.5S
PIPELINE_FAILURE_RATE=0.05

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8081/api/v1
VITE_HIDE_DEMO=false
